<% content_for :title, "Jobs - LarpIn" %>
<div class="max-w-2xl mx-auto flex flex-col gap-3">
  <div class="flex items-center justify-between px-1">
    <div>
      <h1 class="font-bold text-lg">LarpIn Jobs</h1>
      <p class="text-xs text-ink/50">Every listing is fake. Every rejection is instant. Just like real life, but faster.</p>
    </div>
    <%= link_to "+ Post a job", new_job_path, class: "text-sm font-bold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 py-2 shrink-0" %>
  </div>

  <% @jobs.each do |job| %>
    <div class="card p-5">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 class="font-bold text-base text-cobalt-800"><%= job.title %></h2>
          <p class="text-sm text-ink/70"><%= job.company %></p>
          <p class="text-xs text-ink/50 mt-0.5">
            <%= job.location.presence || "Location undisclosed (stealth)" %>
            · <%= job.comp.presence || "Compensation: vibes" %>
            · <%= pluralize(job.applications_count, "rejection") %> issued
          </p>
        </div>
        <% if job.applied_by?(current_persona) %>
          <span class="text-xs font-semibold text-accent-600 border border-accent-500/40 rounded-full px-3 py-1.5 shrink-0">Rejected ✓</span>
        <% else %>
          <%= button_to "Easy Apply", apply_job_path(job), class: "text-xs font-bold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 py-1.5 cursor-pointer shrink-0" %>
        <% end %>
      </div>
      <% if job.description.present? %>
        <p class="text-sm mt-2 whitespace-pre-line text-ink/80"><%= job.description %></p>
      <% end %>
      <p class="text-[11px] text-ink/40 mt-2">Posted by <%= link_to job.persona.name, persona_path(job.persona), class: "hover:underline font-medium" %> · <%= short_time_ago(job.created_at) %> ago</p>
    </div>
  <% end %>
</div>
