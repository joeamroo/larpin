<% content_for :title, "Post a job - LarpIn" %>
<div class="max-w-lg mx-auto">
  <div class="card p-5">
    <h1 class="display text-2xl mb-1">Post a fake job</h1>
    <p class="text-xs text-ink/50 mb-4">All applicants will be instantly rejected. It's called managing expectations.</p>
    <%= form_with model: @job, url: jobs_path do |f| %>
      <div class="flex flex-col gap-4">
        <div>
          <%= f.label :title, "Job title", class: "block text-xs font-bold mb-1" %>
          <%= f.text_field :title, maxlength: 120, placeholder: "e.g. Senior Vision Haver", class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
        </div>
        <div>
          <%= f.label :company, class: "block text-xs font-bold mb-1" %>
          <%= f.text_field :company, maxlength: 120, placeholder: "e.g. Synergy Labs (Stealth)", class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label :location, class: "block text-xs font-bold mb-1" %>
            <%= f.text_field :location, maxlength: 120, placeholder: "Remote (in office)", class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
          </div>
          <div>
            <%= f.label :comp, "Compensation", class: "block text-xs font-bold mb-1" %>
            <%= f.text_field :comp, maxlength: 120, placeholder: "Exposure + equity(ish)", class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
          </div>
        </div>
        <div>
          <%= f.label :description, class: "block text-xs font-bold mb-1" %>
          <%= f.text_area :description, rows: 4, maxlength: 3000, placeholder: "We're a family...", class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
        </div>
        <div class="flex gap-2">
          <%= f.submit "Publish listing", class: "bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-bold rounded-full px-5 py-2 cursor-pointer" %>
          <%= link_to "Cancel", jobs_path, class: "text-sm font-semibold text-ink/60 px-4 py-2" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
