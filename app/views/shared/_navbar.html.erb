<% unread_notifs = current_persona&.unread_notifications_count.to_i %>
<% unread_msgs = current_persona&.unread_messages_count.to_i %>
<% pending_reqs = current_persona ? current_persona.received_connections.pending.count : 0 %>
<%
  nav_items = [
    { label: "Home", path: root_path, active: current_page?(root_path),
      icon: "M23 9v2h-2v7a3 3 0 0 1-3 3h-4v-6h-4v6H6a3 3 0 0 1-3-3v-7H1V9l11-7 5 3.18V2h3v5.09Z" },
    { label: "My Network", path: network_path, active: current_page?(network_path), badge: pending_reqs,
      icon: "M12 16v6H3v-6a3 3 0 0 1 3-3h3a3 3 0 0 1 3 3Zm5.5-3A3.5 3.5 0 1 0 14 9.5a3.5 3.5 0 0 0 3.5 3.5Zm1 2h-2a2.5 2.5 0 0 0-2.5 2.5V22h7v-4.5a2.5 2.5 0 0 0-2.5-2.5ZM7.5 2A4.5 4.5 0 1 0 12 6.5 4.49 4.49 0 0 0 7.5 2Z" },
    { label: "Jobs", path: jobs_path, active: current_page?(jobs_path),
      icon: "M17 6V5a3 3 0 0 0-3-3h-4a3 3 0 0 0-3 3v1H2v4a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V6ZM9 5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1H9Zm10 9a4 4 0 0 0 3-1.38V17a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3v-4.38A4 4 0 0 0 5 14Z" },
    { label: "Messaging", path: conversations_path, active: current_page?(conversations_path), badge: unread_msgs,
      icon: "M16 4H8a7 7 0 0 0 0 14h4v4l8.16-5.39A6.78 6.78 0 0 0 23 11a7 7 0 0 0-7-7Zm-8 8.25A1.25 1.25 0 1 1 9.25 11 1.25 1.25 0 0 1 8 12.25Zm4 0A1.25 1.25 0 1 1 13.25 11 1.25 1.25 0 0 1 12 12.25Zm4 0A1.25 1.25 0 1 1 17.25 11 1.25 1.25 0 0 1 16 12.25Z" },
    { label: "Notifications", path: notifications_path, active: current_page?(notifications_path), badge: unread_notifs,
      icon: "M22 19h-8.28a2 2 0 1 1-3.44 0H2v-1a4.52 4.52 0 0 1 1.17-2.83l1-1.17V9.14a7.79 7.79 0 0 1 5.91-7.69 5.8 5.8 0 0 1 7.08 5.66v7.16l1 1.17A4.52 4.52 0 0 1 22 18Z" }
  ]
%>
<nav class="sticky top-0 z-40 bg-white border-b border-black/8">
  <div class="max-w-[1128px] mx-auto px-4 flex items-center h-[52px]">
    <%= link_to root_path, class: "flex items-center shrink-0 mr-2", aria: { label: "LarpIn home" } do %>
      <span class="hidden sm:inline text-[27px] font-bold text-cobalt-600 tracking-[-0.045em] leading-none relative top-[-1px] mr-[2px]">Larp</span>
      <span class="w-[34px] h-[34px] rounded-[4px] bg-cobalt-600 text-white font-bold text-[21px] tracking-[-0.045em] leading-none inline-flex items-center justify-center pt-[1px]">in</span>
    <% end %>

    <div class="hidden md:flex items-center gap-2 bg-[#edf3f8] rounded px-3 h-[34px] text-sm text-ink/60 w-[280px] cursor-not-allowed ml-1" title="Search is a Premium feature. Premium does not exist.">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="m21 21-4.3-4.3M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"/></svg>
      <span class="truncate">Search (Premium only)</span>
    </div>

    <div class="flex items-center ml-auto h-full">
      <% nav_items.each do |item| %>
        <%= link_to item[:path], class: "relative flex flex-col items-center justify-center h-full w-[64px] sm:w-[80px] #{item[:active] ? 'text-ink' : 'text-ink/60 hover:text-ink'}" do %>
          <span class="relative">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="<%= item[:icon] %>"/></svg>
            <% if item[:badge].to_i > 0 %>
              <span class="absolute -top-1 -right-1.5 bg-[#cb112d] text-white text-[11px] font-semibold rounded-full min-w-[16px] h-4 px-1 flex items-center justify-center leading-none"><%= item[:badge] %></span>
            <% end %>
          </span>
          <span class="text-xs leading-tight mt-0.5 hidden sm:block"><%= item[:label] %></span>
          <% if item[:active] %><span class="absolute bottom-0 inset-x-2 h-0.5 bg-ink rounded-full"></span><% end %>
        <% end %>
      <% end %>
      <% if current_persona %>
        <%= link_to persona_path(current_persona), class: "flex flex-col items-center justify-center h-full w-[64px] sm:w-[80px] text-ink/60 hover:text-ink" do %>
          <%= avatar_tag(current_persona, size: 8, classes: "!w-6 !h-6 !text-[9px]") %>
          <span class="text-xs leading-tight mt-0.5 hidden sm:block">Me</span>
        <% end %>
      <% end %>
    </div>
  </div>
</nav>
