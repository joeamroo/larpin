<div class="card p-4">
  <div class="flex items-center justify-between mb-2">
    <h3 class="display text-[15px]">LarpIn News</h3>
    <%= link_to "Write news", new_article_path, class: "text-xs font-semibold text-cobalt-600 hover:underline" %>
  </div>
  <p class="text-xs text-ink/50 mb-2">Top stories, reported by whoever felt like it</p>
  <ul class="space-y-2">
    <% Article.latest.includes(:persona).limit(5).each do |article| %>
      <li class="flex gap-1.5">
        <span class="text-ink/70 text-[8px] leading-[18px]">●</span>
        <div class="min-w-0">
          <%= link_to article.headline, article_path(article), class: "font-semibold text-[13px] leading-snug hover:underline hover:text-cobalt-600 block" %>
          <p class="text-xs text-ink/50 num mt-0.5"><%= short_time_ago(article.created_at) %> ago · <%= number_with_delimiter(article.readers) %> readers</p>
        </div>
      </li>
    <% end %>
  </ul>
  <%= link_to "Show all news →", articles_path, class: "block mt-3 text-xs font-semibold text-ink/60 hover:text-cobalt-600" %>
</div>

<p class="text-xs text-ink/50 px-2 leading-relaxed">
  LarpIn © 2026 · Built by <a href="https://montroselabs.ai" target="_blank" rel="noopener" class="font-semibold text-ink/70 hover:text-cobalt-600 hover:underline">Youssef of Montrose Labs</a>
  · <a href="https://x.com/joseamroo" target="_blank" rel="noopener" class="font-semibold text-ink/70 hover:text-cobalt-600 hover:underline">@joseamroo</a>
  · <a href="https://github.com/joeamroo/larpin" target="_blank" rel="noopener" class="font-semibold text-ink/70 hover:text-cobalt-600 hover:underline">Open source, contribute →</a>
</p>

<% celebrant = Persona.bots.where("base_clout < 500").where(larping_since: ..1.year.ago).order("RANDOM()").first %>
<% if celebrant %>
  <div class="card p-4">
    <h3 class="display text-[15px] mb-3">Today's milestones</h3>
    <div class="flex items-start gap-3">
      <%= avatar_tag(celebrant, size: 10) %>
      <div class="text-xs">
        <p><%= link_to celebrant.name, persona_path(celebrant), class: "font-semibold hover:underline" %> is celebrating <span class="font-semibold"><%= pluralize(celebrant.years_larping, "year") %></span> of larping.</p>
        <%= button_to "Say congrats 🎉", conversations_path(persona_id: celebrant.id), form_class: "btn-form", class: "mt-2 text-cobalt-600 font-semibold border border-cobalt-600 rounded-full px-3 py-1 hover:bg-cobalt-50 cursor-pointer" %>
      </div>
    </div>
  </div>
<% end %>

<div class="card p-4 border-gold-500/40">
  <h3 class="display text-[15px] text-gold-500">Try LarpIn Premium</h3>
  <p class="text-xs text-ink/60 mt-1">A gold badge. That's it. That's the feature. $0/month, billed never.</p>
  <button class="mt-2 text-xs font-semibold text-white bg-gold-500 rounded-full px-3 py-1.5 opacity-90 hover:opacity-100 cursor-not-allowed" title="Coming never">Start free trial of nothing</button>
</div>

<div class="card p-4">
  <h3 class="display text-[15px] mb-3">Add to your feed</h3>
  <div class="flex flex-col gap-3">
    <% Persona.where.not(id: current_persona&.id).where.not(name: "LarpIn Premium").order(Arel.sql("is_bot ASC, RANDOM()")).limit(3).each do |suggestion| %>
      <div class="flex items-start gap-2.5">
        <%= link_to persona_path(suggestion) do %><%= avatar_tag(suggestion, size: 10) %><% end %>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1"><%= link_to suggestion.name, persona_path(suggestion), class: "font-semibold text-[13px] hover:underline truncate" %><%= premium_badge(suggestion) %></div>
          <p class="text-xs text-ink/50 truncate"><%= suggestion.headline %></p>
          <%= button_to connections_path(receiver_id: suggestion.id), form_class: "btn-form", class: "mt-1.5 inline-flex items-center gap-1 text-xs font-semibold text-ink/70 border border-ink/40 rounded-full px-3 py-1 hover:bg-black/5 hover:border-ink cursor-pointer" do %>
            <span class="text-sm leading-none">+</span> Connect
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="card p-4">
  <h3 class="display text-[15px]">Recruit fellow larpers</h3>
  <p class="text-xs text-ink/60 mt-1 mb-2.5">Every network needs more people pretending. Send LarpIn to a friend who posts "humbled to announce" unironically.</p>
  <div class="flex flex-wrap gap-1.5">
    <button data-controller="web-share" data-web-share-title-value="LarpIn" data-web-share-text-value="Found your new professional network. Everyone is fake and everyone admits it:" data-web-share-url-value="<%= root_url %>" data-action="web-share#share"
            class="text-xs font-semibold px-3 py-1.5 rounded-full bg-cobalt-600 text-white hover:bg-cobalt-700 cursor-pointer">Share to friends...</button>
    <a href="https://wa.me/?text=<%= u("Found your new professional network. Everyone is fake and everyone admits it: #{root_url}") %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">WhatsApp</a>
    <a href="https://t.me/share/url?url=<%= u(root_url) %>&text=<%= u("Your new professional network. Everyone is fake and everyone admits it.") %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">Telegram</a>
    <a href="https://twitter.com/intent/tweet?text=<%= u("LinkedIn, but everyone admits they're larping:") %>&url=<%= u(root_url) %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">X</a>
  </div>
</div>

