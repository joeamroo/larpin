<div class="card p-4">
  <div class="flex items-center justify-between mb-2">
    <h3 class="display text-[15px]">LarpIn News</h3>
    <%= link_to "Write news", new_article_path, class: "text-xs font-semibold text-cobalt-600 hover:underline" %>
  </div>
  <p class="text-xs text-ink/50 mb-2.5">Top stories, reported by whoever felt like it</p>
  <ul class="text-xs space-y-2.5">
    <% Article.latest.includes(:persona).limit(5).each do |article| %>
      <li>
        <%= link_to article.headline, article_path(article), class: "font-semibold text-[13px] leading-snug hover:underline hover:text-cobalt-600 block" %>
        <p class="text-ink/50 num mt-0.5"><%= short_time_ago(article.created_at) %> ago · <%= number_with_delimiter(article.readers) %> readers</p>
      </li>
    <% end %>
  </ul>
  <%= link_to "Show all news →", articles_path, class: "block mt-3 text-xs font-semibold text-ink/60 hover:text-cobalt-600" %>
</div>

<% celebrant = Persona.bots.where("base_clout < 500").where(larping_since: ..1.year.ago).order("RANDOM()").first %>
<% if celebrant %>
  <div class="card p-4">
    <h3 class="display text-[15px] mb-3">Today's milestones</h3>
    <div class="flex items-start gap-3">
      <%= avatar_tag(celebrant, size: 10) %>
      <div class="text-xs">
        <p><%= link_to celebrant.name, persona_path(celebrant), class: "font-semibold hover:underline" %> is celebrating <span class="font-semibold"><%= pluralize(celebrant.years_larping, "year") %></span> of larping.</p>
        <%= button_to "Say congrats 🎉", conversations_path(persona_id: celebrant.id), class: "mt-2 text-cobalt-600 font-semibold border border-cobalt-600 rounded-full px-3 py-1 hover:bg-cobalt-50 cursor-pointer" %>
      </div>
    </div>
  </div>
<% end %>

<div class="card p-4 border-gold-500/40">
  <h3 class="display text-[15px] text-gold-500">Try LarpIn Premium</h3>
  <p class="text-xs text-ink/60 mt-1">A gold badge. That's it. That's the feature. $0/month, billed never.</p>
  <button class="mt-2 text-xs font-semibold text-white bg-gold-500 rounded-full px-3 py-1.5 opacity-90 hover:opacity-100 cursor-not-allowed" title="Coming never">Start free trial of nothing</button>
</div>

<p class="text-xs text-ink/40 px-2">Share LarpIn: the only network where being fake is being honest.</p>
