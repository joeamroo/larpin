<div class="hidden fixed inset-0 z-50" data-controller="welcome" data-welcome-target="overlay">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-[2px]" data-action="click->welcome#dismiss"></div>
  <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:flex sm:items-center sm:justify-center sm:p-6 pointer-events-none">
    <div class="pointer-events-auto bg-white rounded-t-2xl sm:rounded-xl shadow-2xl w-full sm:max-w-[440px] max-h-[92dvh] sm:max-h-[88vh] flex flex-col overflow-hidden transition-all duration-300 translate-y-4 opacity-0" data-welcome-target="card">

      <div class="bg-cobalt-600 px-5 py-3.5 flex items-center justify-between shrink-0">
        <span class="flex items-center">
          <span class="text-[21px] font-bold text-white tracking-[-0.045em] leading-none mr-[2px]">Larp</span>
          <span class="w-[27px] h-[27px] rounded-[4px] bg-white text-cobalt-600 font-bold text-[16px] tracking-[-0.045em] leading-none inline-flex items-center justify-center">in</span>
        </span>
        <button class="text-white/80 hover:text-white w-8 h-8 -mr-1.5 rounded-full hover:bg-white/10 cursor-pointer inline-flex items-center justify-center" data-action="welcome#dismiss" aria-label="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <div class="px-5 sm:px-6 pt-4 sm:pt-5 pb-5 overflow-y-auto overscroll-contain pb-[max(1.25rem,env(safe-area-inset-bottom))]">
        <h2 class="text-[17px] sm:text-[19px] font-bold leading-snug tracking-[-0.01em]">Half of LinkedIn is already performance art.<br class="hidden sm:block"> This is the honest version.</h2>
        <p class="text-[13px] sm:text-sm text-ink/65 mt-2 leading-relaxed">
          The 4 AM routines. The layoffs that become personal wins. The stories that end in
          "and that intern was me." Everyone plays a character and nobody admits it.
          Here, everyone admits it. Get larppilled. Start larpmaxxing.
          Become the main character of someone's quarterly report.
        </p>

        <% if current_persona %>
          <div class="mt-4 rounded-lg border border-black/10 bg-paper/70 p-3">
            <p class="text-[10.5px] font-semibold text-ink/45 uppercase tracking-[0.06em] mb-2">Your account · invented just now</p>
            <div class="flex items-center gap-2.5">
              <%= avatar_tag(current_persona, size: 10) %>
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-sm leading-tight truncate"><%= current_persona.name %></p>
                <p class="text-xs text-ink/55 leading-tight truncate mt-0.5"><%= current_persona.headline %></p>
              </div>
              <%= button_to "🎲 Reroll", regenerate_my_persona_path, form_class: "btn-form", class: "shrink-0 text-xs font-semibold text-cobalt-600 border border-cobalt-600 rounded-full px-3 py-1.5 hover:bg-cobalt-50 cursor-pointer whitespace-nowrap", title: "Different name, different lies" %>
            </div>
            <p class="text-xs text-ink/50 mt-2 leading-snug">No signup. No email. No verification. Registration was the first thing we larped.</p>
          </div>
        <% end %>

        <div class="mt-4 flex flex-col sm:flex-row gap-2">
          <button data-action="welcome#dismiss" class="flex-1 bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-bold rounded-full py-2.5 cursor-pointer">Start larpmaxxing</button>
          <%= link_to "Pick my name & claim it", signup_path, class: "flex-1 text-center text-sm font-semibold text-cobalt-600 border border-cobalt-600 rounded-full py-2.5 hover:bg-cobalt-50" %>
        </div>

        <p class="text-center text-xs text-ink/45 mt-3 leading-relaxed">
          <%= link_to "Already claimed? Sign in", login_path, class: "font-semibold text-cobalt-600 hover:underline" %>
          <span class="mx-1 text-ink/30">·</span>
          Built by <a href="https://montroselabs.ai" target="_blank" rel="noopener" class="font-semibold hover:text-cobalt-600 hover:underline">Youssef of Montrose Labs</a>
          <span class="mx-1 text-ink/30">·</span>
          <a href="https://x.com/joseamroo" target="_blank" rel="noopener" class="font-semibold hover:text-cobalt-600 hover:underline">@joseamroo</a>
        </p>
      </div>
    </div>
  </div>
</div>
