<% content_for :title, "My Network - LarpIn" %>
<div class="max-w-2xl mx-auto flex flex-col gap-3">
  <% if @pending.any? %>
    <div class="card p-5">
      <h2 class="display text-[15px] mb-3">Invitations (<%= @pending.count %>)</h2>
      <div class="flex flex-col gap-3">
        <% @pending.each do |connection| %>
          <div class="flex items-center gap-3">
            <%= link_to persona_path(connection.requester) do %><%= avatar_tag(connection.requester, size: 12) %><% end %>
            <div class="min-w-0 flex-1">
              <%= link_to connection.requester.name, persona_path(connection.requester), class: "font-bold text-sm hover:underline" %>
              <p class="text-xs text-ink/50 truncate"><%= connection.requester.headline %></p>
            </div>
            <%= button_to "Accept", connection_path(connection), method: :patch, form_class: "btn-form", class: "text-xs font-bold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 py-1.5 cursor-pointer shrink-0" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card p-5">
    <h2 class="display text-[15px] mb-1">People you may be pretending to know</h2>
    <p class="text-xs text-ink/50 mb-3">Suggested because the algorithm needed to suggest someone.</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <% @suggestions.each do |persona| %>
        <div class="border border-black/10 rounded-xl p-3 text-center">
          <%= link_to persona_path(persona), class: "inline-block" do %><%= avatar_tag(persona, size: 12, classes: "mx-auto") %><% end %>
          <%= link_to persona.name, persona_path(persona), class: "block font-bold text-xs mt-2 hover:underline truncate" %>
          <p class="text-xs text-ink/50 truncate mb-2"><%= persona.headline %></p>
          <%= button_to "Connect", connections_path(receiver_id: persona.id), form_class: "btn-form", class: "w-full text-xs font-semibold text-cobalt-700 border border-cobalt-600 rounded-full py-1 hover:bg-cobalt-50 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card p-5">
    <h2 class="display text-[15px] mb-3">Your connections (<%= @accepted.count %> real, <%= @persona.base_clout %> implied)</h2>
    <% if @accepted.any? %>
      <div class="flex flex-col gap-3">
        <% @accepted.each do |connection| %>
          <% other = connection.other(@persona) %>
          <div class="flex items-center gap-3">
            <%= link_to persona_path(other) do %><%= avatar_tag(other, size: 10) %><% end %>
            <div class="min-w-0 flex-1">
              <%= link_to other.name, persona_path(other), class: "font-bold text-sm hover:underline" %>
              <p class="text-xs text-ink/50 truncate"><%= other.headline %></p>
            </div>
            <%= button_to "Message", conversations_path(persona_id: other.id), form_class: "btn-form", class: "text-xs font-semibold text-cobalt-700 border border-cobalt-600 rounded-full px-3 py-1 hover:bg-cobalt-50 cursor-pointer shrink-0" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-ink/50">No connections yet. Your <%= @persona.base_clout %> implied connections believe in you.</p>
    <% end %>
  </div>
</div>
