<% content_for :title, "#{@persona.name} - LarpIn" %>
<% own_profile = current_persona&.id == @persona.id %>
<div class="max-w-2xl mx-auto flex flex-col gap-3">

  <div class="card overflow-hidden">
    <%= cover_tag(@persona, "h-32") %>
    <div class="px-5 pb-5 -mt-12">
      <%= avatar_tag(@persona, size: 24, ring: true) %>
      <div class="flex flex-wrap items-start justify-between gap-3 mt-3">
        <div>
          <h1 class="text-2xl font-semibold flex items-center gap-2">
            <%= @persona.name %>
            <%= verified_check(@persona) %>
            <%= premium_badge(@persona) %>
            <% if @persona.is_bot %><span class="text-xs font-bold uppercase bg-paper border border-black/10 rounded-full px-2 py-0.5 text-ink/50" title="This persona is a bot. The honesty is refreshing.">Bot</span><% end %>
          </h1>
          <div class="flex flex-wrap items-center gap-1.5 mt-1">
            <% if @persona.open_to_larp? %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-white bg-[#01754f] rounded-full px-2.5 py-0.5">#OpenToLarp</span>
            <% end %>
            <% if @persona.pilled.present? %><span class="text-xs font-semibold text-cobalt-700 bg-cobalt-50 border border-cobalt-200 rounded-full px-2.5 py-0.5">#<%= @persona.pilled %></span><% end %>
            <% if @persona.coded.present? %><span class="text-xs font-semibold text-accent-600 bg-accent-500/10 border border-accent-500/30 rounded-full px-2.5 py-0.5"><%= @persona.coded %></span><% end %>
          </div>
          <p class="text-[15px] text-ink/80 mt-1"><%= @persona.headline %></p>
          <p class="text-sm text-ink/60 mt-1">
            The Feed, Internet ·
            <span class="font-semibold text-cobalt-600"><%= @persona.clout_display %> connections</span>
          </p>
          <p class="text-xs text-ink/50 mt-0.5">
            Larping since <%= @persona.larping_since.year %> ·
            <span class="font-semibold text-accent-600">✨ <%= number_with_delimiter(@persona.aura) %> aura</span> (<%= @persona.aura_tier %>)
            <% if @persona.streak >= 2 %> · <span class="font-semibold">🔥 <%= @persona.streak %>-day streak</span><% end %>
          </p>
        </div>
        <div class="flex gap-2 shrink-0">
          <% if own_profile %>
            <% if @persona.can_verify? %>
              <%= button_to "Get verified", verify_my_persona_path, form_class: "btn-form", class: "text-sm font-bold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 py-1.5 cursor-pointer", title: "You have 100+ aura. Claim your blue check." %>
            <% end %>
            <%= link_to "Edit persona", edit_my_persona_path, class: "text-sm font-semibold text-cobalt-600 border border-cobalt-600 rounded-full px-4 py-1.5 hover:bg-cobalt-50" %>
          <% else %>
            <% existing = current_persona&.connection_with(@persona) %>
            <% if existing&.status == "accepted" %>
              <span class="text-sm font-semibold text-ink/50 border border-black/10 rounded-full px-4 py-1.5">✓ Connected</span>
            <% elsif existing %>
              <span class="text-sm font-semibold text-ink/50 border border-black/10 rounded-full px-4 py-1.5">Pending</span>
            <% else %>
              <%= button_to "Connect", connections_path(receiver_id: @persona.id), form_class: "btn-form", class: "text-sm font-bold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 py-1.5 cursor-pointer" %>
            <% end %>
            <%= button_to "Message", conversations_path(persona_id: @persona.id), form_class: "btn-form", class: "text-sm font-semibold text-cobalt-600 border border-cobalt-600 rounded-full px-4 py-1.5 hover:bg-cobalt-50 cursor-pointer" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <% if own_profile %>
    <div class="card p-4">
      <h2 class="display text-[15px] mb-2">Analytics <span class="text-xs font-normal text-ink/40">· Private to you, like all delusions</span></h2>
      <div class="grid grid-cols-3 gap-2 text-center sm:text-left">
        <%= link_to profile_views_path, class: "hover:bg-black/5 rounded p-1.5 -m-1.5" do %>
          <p class="font-bold text-base text-cobalt-600 num"><%= @persona.id * 137 % 9000 + 240 %></p>
          <p class="text-xs text-ink/60">profile views</p>
        <% end %>
        <div class="p-1.5 -m-1.5">
          <p class="font-bold text-base text-cobalt-600 num"><%= number_with_delimiter(@persona.posts.sum(&:impressions)) %></p>
          <p class="text-xs text-ink/60">post impressions</p>
        </div>
        <div class="p-1.5 -m-1.5">
          <p class="font-bold text-base text-cobalt-600 num"><%= @persona.id * 89 % 2500 + 47 %></p>
          <p class="text-xs text-ink/60">search appearances (imagined)</p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @persona.bio.present? || own_profile %>
    <div class="card p-5">
      <h2 class="display text-lg mb-2">About</h2>
      <% if @persona.bio.present? %>
        <p class="text-sm whitespace-pre-line text-ink/80"><%= @persona.bio %></p>
      <% else %>
        <p class="text-sm text-ink/50 italic">You haven't written an About yet. <%= link_to "Fabricate one", edit_my_persona_path, class: "text-cobalt-600 font-semibold not-italic hover:underline" %>.</p>
      <% end %>
    </div>
  <% end %>

  <div class="card p-5">
    <div class="flex items-center justify-between mb-3">
      <h2 class="display text-lg">Experience</h2>
      <% if own_profile %>
        <span class="text-xs text-ink/50"><%= @experiences.count %>/unverifiable</span>
      <% end %>
    </div>

    <% if @experiences.any? %>
      <div class="flex flex-col divide-y divide-black/5">
        <% @experiences.each do |experience| %>
          <div class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
            <div class="w-12 h-12 shrink-0 rounded flex items-center justify-center text-white font-bold text-lg"
                 style="background: hsl(<%= (experience.company.sum * 7) % 360 %>, 45%, 40%);"><%= experience.company[0].upcase %></div>
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-[15px] leading-tight"><%= experience.title %></h3>
              <p class="text-sm text-ink/80"><%= experience.company %></p>
              <p class="text-xs text-ink/50 num"><%= experience.years_label %> · <%= experience.duration_label %></p>
              <% if experience.description.present? %>
                <p class="text-sm text-ink/70 mt-1.5 whitespace-pre-line"><%= experience.description %></p>
              <% end %>
            </div>
            <% if own_profile %>
              <%= button_to "Remove", experience_path(experience), method: :delete, form: { data: { turbo_confirm: "Erase this from history?" } }, form_class: "btn-form", class: "text-xs text-ink/40 hover:text-accent-600 cursor-pointer shrink-0" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-ink/50 italic"><%= own_profile ? "No experience listed. Bold. Honest, even." : "No experience listed. The resume is the absence of a resume." %></p>
    <% end %>

    <% if own_profile %>
      <details class="mt-4 group">
        <summary class="text-sm font-semibold text-cobalt-600 cursor-pointer hover:underline list-none">+ Add experience</summary>
        <%= form_with url: experiences_path, class: "mt-3 border border-black/10 rounded-lg p-4" do |f| %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-bold mb-1">Title</label>
              <%= f.text_field "experience[title]", maxlength: 100, placeholder: "Chief Visionary Officer", required: true, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
            </div>
            <div>
              <label class="block text-xs font-bold mb-1">Company</label>
              <%= f.text_field "experience[company]", maxlength: 100, placeholder: "Stealth (very stealth)", required: true, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
            </div>
            <div>
              <label class="block text-xs font-bold mb-1">Start year</label>
              <%= f.number_field "experience[start_year]", in: 1900..2100, value: Date.current.year, required: true, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
            </div>
            <div>
              <label class="block text-xs font-bold mb-1">End year (blank = Present)</label>
              <%= f.number_field "experience[end_year]", in: 1900..2100, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
            </div>
          </div>
          <div class="mt-3">
            <label class="block text-xs font-bold mb-1">Description</label>
            <%= f.text_area "experience[description]", rows: 2, maxlength: 1000, placeholder: "Drove synergies. Owned outcomes. Attended standups.", class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
          </div>
          <%= f.submit "Add to history", class: "mt-3 bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-bold rounded-full px-4 py-1.5 cursor-pointer" %>
        <% end %>
      </details>
    <% end %>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between mb-3">
      <h2 class="display text-lg">Skills</h2>
      <span class="text-xs text-ink/50">endorsed by people who've never seen the work</span>
    </div>

    <% if @skills.any? %>
      <div class="flex flex-col divide-y divide-black/5">
        <% @skills.each do |skill| %>
          <div class="flex items-center gap-3 py-2.5 first:pt-0 last:pb-0">
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-sm"><%= skill.name %></p>
              <p class="text-xs text-ink/50 num"><%= pluralize(@endorsement_counts[skill.name].to_i, "endorsement") %></p>
            </div>
            <% if own_profile %>
              <%= button_to "Remove", profile_skill_path(skill), method: :delete, form_class: "btn-form", class: "text-xs text-ink/40 hover:text-accent-600 cursor-pointer shrink-0" %>
            <% elsif current_persona %>
              <% already = @persona.endorsements.exists?(endorser_id: current_persona.id, skill: skill.name) %>
              <% if already %>
                <span class="text-xs font-semibold text-ink/50 border border-black/10 rounded-full px-3 py-1 shrink-0">✓ Endorsed</span>
              <% else %>
                <%= button_to "Endorse", endorse_persona_path(@persona, skill: skill.name), form_class: "btn-form", class: "text-xs font-semibold text-cobalt-600 border border-cobalt-600 rounded-full px-3 py-1 hover:bg-cobalt-50 cursor-pointer shrink-0" %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-ink/50 italic"><%= own_profile ? "No skills claimed yet. Claim some below; proof is not required." : "No skills claimed. Extremely confident move." %></p>
    <% end %>

    <% if own_profile %>
      <%= form_with url: profile_skills_path, class: "mt-4 flex gap-2" do |f| %>
        <%= f.text_field "profile_skill[name]", maxlength: 40, placeholder: "Claim a skill (e.g. Larpmaxxing, Aura Farming)", required: true, class: "flex-1 rounded-full border border-black/15 px-4 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
        <%= f.submit "Claim", class: "text-xs font-bold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 cursor-pointer" %>
      <% end %>
    <% end %>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between mb-3">
      <h2 class="display text-lg">Licenses &amp; certifications</h2>
      <% if own_profile %>
        <%= button_to "Complete a course (instant)", certifications_path, form_class: "btn-form", class: "text-xs font-semibold text-cobalt-600 border border-cobalt-600 rounded-full px-3 py-1 hover:bg-cobalt-50 cursor-pointer", title: "LarpIn Learning: no exam, no content, credential only" %>
      <% end %>
    </div>
    <% certifications = @persona.certifications.order(created_at: :desc) %>
    <% if certifications.any? %>
      <div class="flex flex-col divide-y divide-black/5">
        <% certifications.each do |certification| %>
          <div class="flex items-start gap-3 py-2.5 first:pt-0 last:pb-0">
            <div class="w-10 h-10 shrink-0 rounded bg-gold-500/15 text-gold-500 flex items-center justify-center">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-4 12.74V22l4-2 4 2v-7.26A7 7 0 0 0 12 2Zm0 10a3 3 0 1 1 3-3 3 3 0 0 1-3 3Z"/></svg>
            </div>
            <div class="min-w-0">
              <p class="font-semibold text-sm leading-snug"><%= certification.course %></p>
              <p class="text-xs text-ink/60">LarpIn Learning · <%= certification.hours %></p>
              <p class="text-xs text-ink/50">Issued <%= certification.created_at.strftime("%b %Y") %> · No exam. No content. Credential only.</p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-ink/50 italic"><%= own_profile ? "No certifications yet. Complete a course above; it takes less time than reading this sentence." : "No certifications. Refreshingly unqualified." %></p>
    <% end %>
  </div>

  <div class="card p-5 pb-2">
    <h2 class="display text-lg mb-3">Activity</h2>
    <% if @posts.any? %>
      <p class="text-xs text-ink/50 -mt-2 mb-3"><%= pluralize(@persona.posts_count, "larp") %> published</p>
    <% else %>
      <p class="text-sm text-ink/50 italic mb-3">No posts yet. The most powerful larp is silence.</p>
    <% end %>
  </div>
  <% @posts.each do |post| %>
    <%= render "posts/post", post: post %>
  <% end %>
</div>
