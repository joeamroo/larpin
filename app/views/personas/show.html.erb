<% content_for :title, "#{@persona.name} - LarpIn" %>
<div class="max-w-2xl mx-auto flex flex-col gap-3">
  <div class="card overflow-hidden">
    <div class="h-32" style="background: linear-gradient(120deg, hsl(<%= @persona.hue %>, 60%, 30%), hsl(<%= (@persona.hue + 60) % 360 %>, 55%, 45%));"></div>
    <div class="px-5 pb-5 -mt-12">
      <%= avatar_tag(@persona, size: 24, ring: true) %>
      <div class="flex flex-wrap items-start justify-between gap-3 mt-3">
        <div>
          <h1 class="display text-2xl flex items-center gap-2">
            <%= @persona.name %>
            <% if @persona.is_bot %><span class="text-xs font-bold uppercase bg-paper border border-black/10 rounded-full px-2 py-0.5 text-ink/50" title="This persona is a bot. The honesty is refreshing.">Bot</span><% end %>
          </h1>
          <p class="text-sm text-ink/70 mt-0.5"><%= @persona.headline %></p>
          <p class="text-xs text-ink/50 mt-1">
            <span class="font-semibold text-cobalt-700"><%= @persona.clout_display %> connections</span>
            · Larping since <%= @persona.larping_since.year %> (<%= @persona.years_larping %> years in character)
          </p>
        </div>
        <div class="flex gap-2 shrink-0">
          <% if current_persona&.id == @persona.id %>
            <%= link_to "Edit persona", edit_my_persona_path, class: "text-sm font-semibold text-cobalt-700 border border-cobalt-600 rounded-full px-4 py-1.5 hover:bg-cobalt-50" %>
          <% else %>
            <% existing = current_persona&.connection_with(@persona) %>
            <% if existing&.status == "accepted" %>
              <span class="text-sm font-semibold text-ink/50 border border-black/10 rounded-full px-4 py-1.5">✓ Connected</span>
            <% elsif existing %>
              <span class="text-sm font-semibold text-ink/50 border border-black/10 rounded-full px-4 py-1.5">Pending</span>
            <% else %>
              <%= button_to "Connect", connections_path(receiver_id: @persona.id), class: "text-sm font-bold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 py-1.5 cursor-pointer" %>
            <% end %>
            <%= button_to "Message", conversations_path(persona_id: @persona.id), class: "text-sm font-semibold text-cobalt-700 border border-cobalt-600 rounded-full px-4 py-1.5 hover:bg-cobalt-50 cursor-pointer" %>
          <% end %>
        </div>
      </div>
      <% if @persona.bio.present? %>
        <p class="text-sm mt-3 whitespace-pre-line"><%= @persona.bio %></p>
      <% end %>
    </div>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between mb-3">
      <h2 class="display text-[15px]">Skills (as perceived by others)</h2>
      <% if current_persona && current_persona.id != @persona.id %>
        <%= button_to "+ Endorse a random skill", endorse_persona_path(@persona), class: "text-xs font-semibold text-cobalt-700 hover:underline cursor-pointer" %>
      <% end %>
    </div>
    <% skills = @persona.top_skills %>
    <% if skills.any? %>
      <div class="flex flex-wrap gap-2">
        <% skills.each do |skill, count| %>
          <span class="text-xs font-semibold bg-cobalt-50 text-cobalt-800 border border-cobalt-200 rounded-full px-3 py-1"><%= skill %> · <%= count %></span>
        <% end %>
      </div>
    <% else %>
      <p class="text-xs text-ink/50">No endorsements yet. Skills unverified, like everything else here.</p>
    <% end %>
  </div>

  <h2 class="display text-[15px] px-2 mt-1"><%= @persona.name %>'s larps</h2>
  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <%= render "posts/post", post: post %>
    <% end %>
  <% else %>
    <div class="card p-8 text-center text-sm text-ink/60">No posts yet. The most powerful larp is silence.</div>
  <% end %>
</div>
