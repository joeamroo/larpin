<div id="<%= dom_id(post, :engagement) %>">
  <% breakdown = post.reaction_breakdown %>
  <% my_reaction = current_persona && post.reactions.find_by(persona_id: current_persona.id) %>
  <div class="flex items-center justify-between px-4 pt-2 pb-1 text-xs text-ink/60">
    <div class="flex items-center gap-1">
      <% if breakdown.any? %>
        <span class="flex -space-x-1">
          <% breakdown.first(3).each do |kind, _| %>
            <span class="w-4 h-4 rounded-full bg-white flex items-center justify-center text-[11px] leading-none"><%= Reaction::KINDS[kind][:emoji] %></span>
          <% end %>
        </span>
        <span class="ml-0.5 num hover:text-cobalt-600 hover:underline cursor-default"><%= post.reactions_count %></span>
      <% end %>
    </div>
    <div class="flex items-center gap-1.5 num">
      <% if post.comments_count > 0 %><span><%= pluralize(post.comments_count, "comment") %></span><span class="text-ink/30">·</span><% end %>
      <span title="Impressions are computed by vibes"><%= number_with_delimiter(post.impressions) %> impressions</span>
      <% if current_persona&.id == post.persona_id %>
        <span class="text-ink/30">·</span>
        <%= link_to "Analytics", analytics_post_path(post), class: "text-cobalt-600 font-semibold hover:underline", data: { turbo_frame: "_top" } %>
        <% unless post.hyped? %>
          <span class="text-ink/30">·</span>
          <%= button_to "🚀 Hype squad", hype_post_path(post), form: { data: { turbo_frame: "_top" } }, form_class: "btn-form", class: "text-accent-600 font-semibold hover:underline cursor-pointer", title: "Summon 3 bots to hype this post. Once per larp." %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="hidden" data-toggle-target="panel" data-panel="picker">
    <div class="px-4 py-1.5 border-t border-black/8 flex flex-wrap gap-1">
    <% Reaction::KINDS.each do |kind, meta| %>
      <%= button_to react_post_path(post, kind: kind),
            class: "inline-block",
            form_class: "inline-block",
            title: meta[:label] do %>
        <span class="cursor-pointer text-sm px-2.5 py-1 rounded-full border <%= my_reaction&.kind == kind ? 'bg-cobalt-100 border-cobalt-500 font-bold' : 'border-black/10 hover:bg-paper' %>">
          <%= meta[:emoji] %> <span class="text-xs font-semibold"><%= meta[:label] %></span>
        </span>
      <% end %>
    <% end %>
    </div>
  </div>

  <div class="flex border-t border-black/8 px-2 py-0.5 text-sm font-semibold text-ink/60">
    <button class="flex-1 flex items-center justify-center gap-1 sm:gap-1.5 py-2.5 rounded hover:bg-black/5 cursor-pointer whitespace-nowrap <%= 'text-cobalt-600' if my_reaction %>"
            data-action="toggle#toggle" data-toggle-name-param="picker">
      <% if my_reaction %>
        <span class="text-base leading-none"><%= Reaction::KINDS[my_reaction.kind][:emoji] %></span>
        <span class="text-xs sm:text-[13px]"><%= Reaction::KINDS[my_reaction.kind][:label] %></span>
      <% else %>
        <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M19.46 11l-3.91-3.91a7 7 0 0 1-1.69-2.74l-.49-1.47A2.76 2.76 0 0 0 10.76 1 2.75 2.75 0 0 0 8 3.74v1.12a9.19 9.19 0 0 0 .46 2.85L8.89 9H4.12A2.12 2.12 0 0 0 2 11.12a2.16 2.16 0 0 0 .92 1.76A2.11 2.11 0 0 0 2 14.62a2.14 2.14 0 0 0 1.28 2 2 2 0 0 0-.32 1.11 2.12 2.12 0 0 0 1.21 1.91 2 2 0 0 0-.06.48A2.12 2.12 0 0 0 6.23 22h7.24a9.2 9.2 0 0 0 4.12-1l.89-.44a2.13 2.13 0 0 0 1.18-1.9V13.12A2.12 2.12 0 0 0 17.54 11Z"/></svg>
        <span class="text-xs sm:text-[13px]">React</span>
      <% end %>
    </button>
    <button class="flex-1 flex items-center justify-center gap-1 sm:gap-1.5 py-2.5 rounded hover:bg-black/5 cursor-pointer whitespace-nowrap" data-action="toggle#toggle" data-toggle-name-param="comments">
      <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M7 9h10v1H7Zm0 4h7v-1H7Zm16-2a6.78 6.78 0 0 1-2.84 5.61L12 22v-4H8A7 7 0 0 1 8 4h8a7 7 0 0 1 7 7Zm-2 0a5 5 0 0 0-5-5H8a5 5 0 0 0 0 10h6v2.28L19 15a4.79 4.79 0 0 0 2-4Z"/></svg>
      <span class="text-xs sm:text-[13px]">Comment</span>
    </button>
    <%= button_to conversations_path(persona_id: post.persona_id), form: { data: { turbo_frame: "_top" } }, form_class: "flex-1", class: "w-full flex items-center justify-center gap-1 sm:gap-1.5 py-2.5 rounded hover:bg-black/5 cursor-pointer whitespace-nowrap font-semibold text-ink/60" do %>
      <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M21 3 0 10l7.66 4.26L16 8l-6.26 8.34L14 24l7-21z"/></svg>
      <span class="text-xs sm:text-[13px]">Reach out</span>
    <% end %>
    <button class="flex-1 flex items-center justify-center gap-1 sm:gap-1.5 py-2.5 rounded hover:bg-black/5 cursor-pointer whitespace-nowrap" data-action="toggle#toggle" data-toggle-name-param="share">
      <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24"><path d="M13.96 5H6a4 4 0 0 0-4 4v10a4 4 0 0 0 .08.78L4 18.15V9a2 2 0 0 1 2-2h7.96L12 8.96 13.41 10.37 17.78 6 13.41 1.63 12 3.04ZM10.04 19H18a4 4 0 0 0 4-4V5a4 4 0 0 0-.08-.78L20 6.15V15a2 2 0 0 1-2 2h-7.96L12 15.04 10.59 13.63 6.22 18 10.59 22.37 12 20.96Z"/></svg>
      <span class="text-xs sm:text-[13px]">Share</span>
    </button>
  </div>
</div>
