<div id="<%= dom_id(post, :engagement) %>">
  <% breakdown = post.reaction_breakdown %>
  <% my_reaction = current_persona && post.reactions.find_by(persona_id: current_persona.id) %>
  <div class="flex items-center justify-between px-4 pt-2.5 pb-1.5 text-xs text-ink/50">
    <div class="flex items-center gap-1">
      <% breakdown.first(3).each do |kind, _| %><span><%= Reaction::KINDS[kind][:emoji] %></span><% end %>
      <span class="ml-1"><%= post.reactions_count %> reactions</span>
    </div>
    <div class="flex items-center gap-3">
      <span><%= post.comments_count %> comments</span>
      <span title="Impressions are computed by vibes"><%= number_with_delimiter(post.impressions) %> impressions</span>
      <% if current_persona&.id == post.persona_id %>
        <%= link_to "Analytics", analytics_post_path(post), class: "text-cobalt-700 font-semibold hover:underline", data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  </div>

  <div class="hidden" data-toggle-target="panel" data-panel="picker">
    <div class="px-4 py-1.5 border-t border-black/5 flex flex-wrap gap-1">
    <% Reaction::KINDS.each do |kind, meta| %>
      <%= button_to react_post_path(post, kind: kind),
            class: "inline-block",
            form_class: "inline-block",
            title: meta[:label] do %>
        <span class="cursor-pointer text-sm px-2.5 py-1 rounded-full border <%= my_reaction&.kind == kind ? 'bg-cobalt-100 border-cobalt-500 font-bold' : 'border-black/10 hover:bg-paper' %>">
          <%= meta[:emoji] %> <span class="text-[11px] font-semibold"><%= meta[:label] %></span>
        </span>
      <% end %>
    <% end %>
    </div>
  </div>

  <div class="flex border-t border-black/5 text-xs font-semibold text-ink/60">
    <button class="flex-1 py-2.5 hover:bg-paper cursor-pointer <%= 'text-cobalt-700' if my_reaction %>"
            data-action="toggle#toggle" data-toggle-name-param="picker">
      <%= my_reaction ? "#{Reaction::KINDS[my_reaction.kind][:emoji]} #{Reaction::KINDS[my_reaction.kind][:label]}" : "👍 React" %>
    </button>
    <button class="flex-1 py-2.5 hover:bg-paper cursor-pointer" data-action="toggle#toggle" data-toggle-name-param="comments">💬 Comment</button>
    <%= button_to conversations_path(persona_id: post.persona_id), form: { data: { turbo_frame: "_top" } }, form_class: "flex-1", class: "w-full py-2.5 hover:bg-paper cursor-pointer font-semibold text-ink/60 text-xs" do %>📨 Reach out<% end %>
    <button class="flex-1 py-2.5 hover:bg-paper cursor-pointer" data-action="toggle#toggle" data-toggle-name-param="share">↗️ Share</button>
  </div>
</div>
