<div class="card p-4" data-controller="composer">
  <%= form_with url: posts_path, multipart: true, data: { composer_target: "form" } do |f| %>
    <div class="flex gap-3">
      <% if current_persona %><%= avatar_tag(current_persona, size: 10) %><% end %>
      <div class="flex-1">
        <%= f.text_area "post[body]",
              rows: 2,
              maxlength: 4000,
              placeholder: "Start a larp... (\"I wasn't going to share this, but...\")",
              class: "w-full resize-none rounded-xl border border-black/15 px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500 min-h-[52px]",
              data: { composer_target: "textarea" } %>
        <div class="flex flex-wrap gap-2 mt-2 empty:hidden" data-composer-target="previews"></div>
        <div class="flex items-center flex-wrap gap-2 mt-2">
          <label class="flex items-center gap-1.5 text-xs font-semibold text-ink/60 hover:text-cobalt-700 cursor-pointer px-2 py-1.5 rounded-lg hover:bg-cobalt-50">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Zm-9 5.5A1.5 1.5 0 1 1 8.5 7 1.5 1.5 0 0 1 10 8.5ZM5 19l4.5-6 3 4 2-2.5L19 19Z"/></svg>
            Media
            <input type="file" name="post[images][]" accept="image/*" multiple class="hidden" data-composer-target="fileInput" data-action="composer#previewImages">
          </label>
          <select name="post[kind]" class="text-xs font-semibold text-ink/60 border border-black/10 rounded-lg px-2 py-1.5 bg-white">
            <option value="post">Share a larp</option>
            <option value="celebration">Celebrate a milestone</option>
          </select>
          <button type="button" data-action="composer#enhance" data-composer-target="enhanceBtn"
                  class="flex items-center gap-1.5 text-xs font-semibold text-accent-600 hover:bg-orange-50 px-2 py-1.5 rounded-lg cursor-pointer">
            ✨ Enhance my larp
          </button>
          <%= f.submit "Post", class: "ml-auto bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-bold rounded-full px-5 py-1.5 cursor-pointer" %>
        </div>
        <p class="hidden text-xs text-ink/40 mt-1" data-composer-target="hint"></p>
      </div>
    </div>
  <% end %>
</div>
