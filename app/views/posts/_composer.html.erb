<div class="card px-4 pt-3 pb-2" data-controller="composer">
  <%= form_with url: posts_path, multipart: true, data: { composer_target: "form" } do |f| %>
    <div class="flex gap-2.5">
      <% if current_persona %><%= link_to persona_path(current_persona), class: "shrink-0" do %><%= avatar_tag(current_persona, size: 12) %><% end %><% end %>
      <div class="flex-1 min-w-0">
        <%= f.text_area "post[body]",
              rows: 1,
              maxlength: 4000,
              placeholder: "Start a larp",
              class: "w-full resize-none rounded-3xl border border-black/25 px-4 py-3 text-sm font-medium placeholder:text-ink/60 focus:outline-none focus:border-cobalt-600 focus:ring-1 focus:ring-cobalt-600 min-h-[48px] leading-snug",
              data: { composer_target: "textarea", action: "input->composer#grow" } %>
        <div class="flex flex-wrap gap-2 mt-2 empty:hidden" data-composer-target="previews"></div>
      </div>
    </div>
    <div class="flex items-center gap-0.5 sm:gap-1 mt-2 sm:pl-[52px]">
      <label class="flex items-center gap-1 sm:gap-1.5 text-xs sm:text-[13px] font-semibold text-ink/60 hover:bg-black/5 cursor-pointer px-2 sm:px-3 py-2 rounded whitespace-nowrap">
        <svg class="w-5 h-5 text-[#378fe9] shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M19 4H5a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3ZM8.5 7.5A1.5 1.5 0 1 1 7 9a1.5 1.5 0 0 1 1.5-1.5ZM20 17a1 1 0 0 1-1 1H5.19L14 9.81 20 14Z"/></svg>
        Media
        <input type="file" name="post[images][]" accept="image/*" multiple class="hidden" data-composer-target="fileInput" data-action="composer#previewImages">
      </label>
      <label class="flex items-center gap-1 sm:gap-1.5 text-xs sm:text-[13px] font-semibold text-ink/60 hover:bg-black/5 cursor-pointer px-2 sm:px-3 py-2 rounded whitespace-nowrap min-w-0">
        <svg class="w-5 h-5 text-[#c37d16] shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-4 12.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26A7 7 0 0 0 12 2ZM9 21a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-1H9Z"/></svg>
        <select name="post[kind]" class="bg-transparent cursor-pointer focus:outline-none text-xs sm:text-[13px] font-semibold text-ink/60 max-w-[110px] sm:max-w-none">
          <option value="post">Share a larp</option>
          <option value="celebration">Celebrate a milestone</option>
        </select>
      </label>
      <button type="button" data-action="composer#enhance" data-composer-target="enhanceBtn"
              class="flex items-center gap-1 sm:gap-1.5 text-xs sm:text-[13px] font-semibold text-accent-600 hover:bg-orange-50 px-2 sm:px-3 py-2 rounded cursor-pointer whitespace-nowrap">
        ✨ Enhance<span class="hidden sm:inline"> my larp</span>
      </button>
      <%= f.submit "Post", class: "ml-auto bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-semibold rounded-full px-4 py-1.5 cursor-pointer" %>
    </div>
    <p class="hidden text-xs text-ink/50 mt-1 pl-[52px]" data-composer-target="hint"></p>
  <% end %>
</div>
