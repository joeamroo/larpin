<% comments_open = local_assigns.fetch(:comments_open, false) %>
<article id="<%= dom_id(post) %>" class="card" data-controller="toggle">
  <% if post.kind == "promoted" %>
    <p class="px-4 pt-2.5 text-xs font-semibold uppercase tracking-wide text-gold-500">Promoted · nobody paid for this</p>
  <% elsif post.kind == "celebration" %>
    <p class="px-4 pt-2.5 text-xs font-semibold uppercase tracking-wide text-accent-500">🎉 Milestone</p>
  <% end %>

  <div class="flex items-start gap-2.5 px-4 pt-3">
    <%= link_to persona_path(post.persona), data: { turbo_frame: "_top" }, class: "shrink-0" do %><%= avatar_tag(post.persona, size: 12) %><% end %>
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-1.5 leading-tight">
        <%= link_to post.persona.name, persona_path(post.persona), class: "font-semibold text-sm text-ink hover:underline hover:text-cobalt-600 truncate", data: { turbo_frame: "_top" } %>
        <span class="text-ink/50 text-xs shrink-0">· <%= post.persona.clout_display %></span>
      </div>
      <p class="text-xs text-ink/55 truncate leading-tight mt-px"><%= post.persona.headline %></p>
      <p class="text-xs text-ink/50 leading-tight mt-px num"><%= short_time_ago(post.created_at) %> · 🌐</p>
    </div>
    <% level = post.larp_level %>
    <span class="shrink-0 text-[11px] font-semibold rounded px-1.5 py-0.5 mt-0.5 num cursor-default
                 <%= level >= 80 ? 'bg-gold-500/15 text-gold-500' : level >= 60 ? 'bg-accent-500/10 text-accent-600' : 'bg-cobalt-50 text-cobalt-600' %>"
          title="<%= post.larp_tier %>. Larp Level is computed from buzzword density, dramatic line breaks, and 4 AM references.">
      Larp Lv. <%= level %>
    </span>
    <% if current_persona&.id == post.persona_id %>
      <%= button_to post_path(post), method: :delete, form: { data: { turbo_confirm: "Retract this larp?", turbo_frame: "_top" } }, class: "shrink-0", title: "Delete" do %>
        <span class="inline-flex items-center justify-center w-8 h-8 -my-1.5 -mr-1 rounded-full text-ink/40 hover:text-ink hover:bg-black/5 cursor-pointer text-lg leading-none">×</span>
      <% end %>
    <% end %>
  </div>

  <% if post.body.present? %>
    <div class="px-4 pt-2.5">
      <div class="post-body whitespace-pre-line clamped" data-toggle-target="panel" data-panel="body" data-toggle-class="clamped"><%= post_body_html(post.body) %></div>
      <% if post.body.length > 280 || post.body.lines.count > 5 %>
        <button class="text-xs font-semibold text-ink/50 hover:text-cobalt-600 cursor-pointer"
                data-action="toggle#toggle" data-toggle-name-param="body"
                data-toggle-target="panel" data-panel="body">...see more</button>
      <% end %>
    </div>
  <% end %>

  <% if post.images.attached? %>
    <div class="mt-2.5 grid <%= post.images.size == 1 ? 'grid-cols-1' : 'grid-cols-2' %> gap-0.5">
      <% post.images.each do |image| %>
        <%= link_to url_for(image), target: "_blank", rel: "noopener" do %>
          <img src="<%= url_for(image) %>" alt="larp evidence" class="w-full object-cover <%= post.images.size == 1 ? 'max-h-[480px]' : 'h-52' %>" loading="lazy">
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render "posts/engagement", post: post %>

  <div class="<%= 'hidden' unless comments_open %> border-t border-black/8 px-4 py-3" data-toggle-target="panel" data-panel="comments">
    <%= form_with url: post_comments_path(post) do |f| %>
      <div class="flex items-center gap-2">
        <% if current_persona %><%= avatar_tag(current_persona, size: 8) %><% end %>
        <%= f.text_field "comment[body]", placeholder: "Add value... or just say \"So true\"", maxlength: 1500, autocomplete: "off",
              class: "flex-1 rounded-full border border-black/25 px-4 py-2 text-sm focus:outline-none focus:border-cobalt-600 focus:ring-1 focus:ring-cobalt-600" %>
        <%= f.submit "Reply", class: "text-[13px] font-semibold text-white bg-cobalt-600 hover:bg-cobalt-700 rounded-full px-4 py-1.5 cursor-pointer" %>
      </div>
    <% end %>
    <div id="<%= dom_id(post, :comments) %>" class="mt-3 flex flex-col gap-2.5">
      <%= render partial: "comments/comment", collection: post.comments.order(created_at: :desc).limit(comments_open ? 100 : 8).includes(:persona).to_a.reverse %>
    </div>
  </div>

  <div class="hidden" data-toggle-target="panel" data-panel="share">
  <div class="border-t border-black/8 px-4 py-2.5 flex flex-wrap items-center gap-1.5">
    <% share_url = post_url(post) %>
    <% share_text = "Peak larp on LarpIn:" %>
    <button data-controller="web-share" data-web-share-title-value="LarpIn" data-web-share-text-value="<%= share_text %>" data-web-share-url-value="<%= share_url %>" data-action="web-share#share"
            class="text-xs font-semibold px-3 py-1.5 rounded-full bg-cobalt-600 text-white hover:bg-cobalt-700 cursor-pointer">Share to friends...</button>
    <a href="https://twitter.com/intent/tweet?text=<%= u(share_text) %>&url=<%= u(share_url) %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">X</a>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= u(share_url) %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">LinkedIn (do it)</a>
    <a href="https://wa.me/?text=<%= u("#{share_text} #{share_url}") %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">WhatsApp</a>
    <a href="https://t.me/share/url?url=<%= u(share_url) %>&text=<%= u(share_text) %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">Telegram</a>
    <a href="https://www.reddit.com/submit?url=<%= u(share_url) %>&title=<%= u(share_text) %>" target="_blank" rel="noopener" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">Reddit</a>
    <a href="mailto:?subject=<%= u("A colleague is larping") %>&body=<%= u("#{share_text} #{share_url}") %>" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5">Email</a>
    <button data-controller="clipboard" data-clipboard-text-value="<%= share_url %>" data-action="clipboard#copy" class="text-xs font-semibold px-3 py-1.5 rounded-full border border-black/15 hover:bg-black/5 cursor-pointer">Copy link</button>
  </div>
  </div>
</article>
