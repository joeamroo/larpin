<% content_for :title, "#{@post.persona.name} on LarpIn" %>
<% content_for :head do %>
  <meta property="og:title" content="<%= @post.persona.name %> on LarpIn">
  <meta property="og:description" content="<%= og_description(@post) %>">
  <meta property="og:type" content="article">
  <meta property="og:url" content="<%= post_url(@post) %>">
  <% if @post.images.attached? %>
    <meta property="og:image" content="<%= url_for(@post.images.first) %>">
  <% end %>
  <meta name="twitter:card" content="summary_large_image">
<% end %>

<div class="max-w-[555px] mx-auto flex flex-col gap-2">
  <%= render "posts/post", post: @post, comments_open: true %>
  <%= link_to "← Back to the feed", root_path, class: "text-sm font-semibold text-cobalt-600 hover:underline px-4 py-1" %>
</div>
