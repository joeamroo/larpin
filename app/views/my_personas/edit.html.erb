<% content_for :title, "Edit persona - LarpIn" %>
<div class="max-w-lg mx-auto">
  <div class="card p-5">
    <h1 class="display text-2xl mb-1">Edit your persona</h1>
    <p class="text-xs text-ink/50 mb-4">Reinvention is free. Authenticity was never on the menu.</p>
    <%= form_with model: @persona, url: my_persona_path, method: :patch, multipart: true do |f| %>
      <div class="flex flex-col gap-4">
        <div>
          <%= f.label :name, class: "block text-xs font-bold mb-1" %>
          <%= f.text_field :name, maxlength: 60, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
        </div>
        <div>
          <%= f.label :headline, "Headline (your best lies, pipe-separated)", class: "block text-xs font-bold mb-1" %>
          <%= f.text_field :headline, maxlength: 140, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
        </div>
        <div>
          <%= f.label :bio, "About (unverifiable)", class: "block text-xs font-bold mb-1" %>
          <%= f.text_area :bio, rows: 4, maxlength: 1200, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-cobalt-500" %>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :avatar, "Profile picture", class: "block text-xs font-bold mb-1" %>
            <%= f.file_field :avatar, accept: "image/*", class: "w-full text-xs text-ink/70 file:mr-2 file:rounded-full file:border-0 file:bg-cobalt-50 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-cobalt-700 file:cursor-pointer" %>
            <% if @persona.avatar.attached? %><p class="text-xs text-ink/50 mt-1">Current: uploaded. New file replaces it.</p><% end %>
          </div>
          <div>
            <%= f.label :cover, "Cover photo", class: "block text-xs font-bold mb-1" %>
            <%= f.file_field :cover, accept: "image/*", class: "w-full text-xs text-ink/70 file:mr-2 file:rounded-full file:border-0 file:bg-cobalt-50 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-cobalt-700 file:cursor-pointer" %>
            <% if @persona.cover.attached? %><p class="text-xs text-ink/50 mt-1">Current: uploaded. New file replaces it.</p><% end %>
          </div>
        </div>
        <div>
          <%= f.label :hue, "Brand color (used when no photos are set)", class: "block text-xs font-bold mb-1" %>
          <%= f.range_field :hue, in: 0..359, class: "w-full accent-cobalt-600" %>
        </div>
        <label class="flex items-center gap-2.5 cursor-pointer">
          <%= f.check_box :open_to_larp, class: "w-4 h-4 accent-[#01754f] cursor-pointer" %>
          <span class="text-sm"><span class="font-semibold text-[#01754f]">#OpenToLarp</span> <span class="text-ink/60">· green ring on your avatar so recruiters know you're accepting quests</span></span>
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :pilled, "What are you pilled on?", class: "block text-xs font-bold mb-1" %>
            <%= f.select :pilled, Persona::PILLED, { include_blank: "None" }, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm bg-white" %>
          </div>
          <div>
            <%= f.label :coded, "What are you coded as?", class: "block text-xs font-bold mb-1" %>
            <%= f.select :coded, Persona::CODED, { include_blank: "None" }, class: "w-full rounded-lg border border-black/15 px-3 py-2 text-sm bg-white" %>
          </div>
        </div>
        <div class="flex gap-2">
          <%= f.submit "Save rebrand", class: "bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-bold rounded-full px-5 py-2 cursor-pointer" %>
          <%= link_to "Cancel", persona_path(@persona), class: "text-sm font-semibold text-ink/60 px-4 py-2" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="card p-5 mt-3">
    <h2 class="display text-lg mb-1">Account</h2>
    <% if @persona.claimed? %>
      <p class="text-sm text-ink/70">Claimed as <span class="font-semibold"><%= @persona.email %></span>. Sign in from any device with it. Verification status: vibes.</p>
      <%= button_to "Sign out", logout_path, method: :delete, form_class: "btn-form", class: "mt-3 text-sm font-semibold text-accent-600 border border-accent-500/50 rounded-full px-4 py-1.5 hover:bg-orange-50 cursor-pointer" %>
    <% else %>
      <p class="text-sm text-ink/70">This persona lives in a cookie. Clear it and you never existed.</p>
      <%= link_to "Claim it with an email + password", signup_path, class: "inline-block mt-3 text-sm font-semibold text-cobalt-600 border border-cobalt-600 rounded-full px-4 py-1.5 hover:bg-cobalt-50" %>
    <% end %>
  </div>
</div>
