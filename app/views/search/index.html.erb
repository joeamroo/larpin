<% content_for :title, "Search - LarpIn" %>
<div class="max-w-xl mx-auto flex flex-col gap-2">
  <div class="card p-4">
    <h1 class="display text-lg mb-1">Search results<% if @query.present? %> for "<%= @query %>"<% end %></h1>
    <p class="text-xs text-gold-500 font-semibold">A Premium feature, delivered at enormous expense (one SQL LIKE query).</p>
  </div>

  <% if @query.blank? %>
    <div class="card p-8 text-center text-sm text-ink/60">Type something in the search bar. Try "synergy". Everyone else does.</div>
  <% else %>
    <% if @personas.any? %>
      <div class="card p-4">
        <h2 class="display text-[15px] mb-3">People</h2>
        <div class="flex flex-col divide-y divide-black/5">
          <% @personas.each do |persona| %>
            <div class="flex items-center gap-3 py-2.5 first:pt-0 last:pb-0">
              <%= link_to persona_path(persona) do %><%= avatar_tag(persona, size: 10) %><% end %>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <%= link_to persona.name, persona_path(persona), class: "font-semibold text-sm hover:underline" %>
                  <%= premium_badge(persona) %>
                </div>
                <p class="text-xs text-ink/55 truncate"><%= persona.headline %></p>
              </div>
              <%= button_to "Message", conversations_path(persona_id: persona.id), form_class: "btn-form", class: "text-xs font-semibold text-cobalt-600 border border-cobalt-600 rounded-full px-3 py-1 hover:bg-cobalt-50 cursor-pointer shrink-0" %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @jobs.any? %>
      <div class="card p-4">
        <h2 class="display text-[15px] mb-3">Jobs</h2>
        <% @jobs.each do |job| %>
          <p class="text-sm py-1"><%= link_to "#{job.title} · #{job.company}", jobs_path, class: "font-semibold hover:underline hover:text-cobalt-600" %></p>
        <% end %>
      </div>
    <% end %>

    <% if @posts.any? %>
      <h2 class="display text-[15px] px-2 mt-1">Larps</h2>
      <% @posts.each do |post| %>
        <%= render "posts/post", post: post %>
      <% end %>
    <% end %>

    <% if @personas.empty? && @posts.empty? && @jobs.empty? %>
      <div class="card p-8 text-center text-sm text-ink/60">
        No results for "<%= @query %>". Either it doesn't exist, or it's in Stealth Mode.
      </div>
    <% end %>
  <% end %>
</div>
