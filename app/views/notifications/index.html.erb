<% content_for :title, "Notifications - LarpIn" %>
<div class="max-w-xl mx-auto">
  <div class="card divide-y divide-black/5">
    <div class="p-4">
      <h1 class="display text-lg">Notifications</h1>
      <p class="text-xs text-ink/50">Some of these are real. The flattering ones are not.</p>
    </div>
    <% if @notifications.any? %>
      <% @notifications.each do |notification| %>
        <%= link_to notification.url.presence || root_path, class: "flex items-start gap-3 p-4 hover:bg-paper #{'bg-cobalt-50/50' unless notification.read}" do %>
          <% if notification.actor %>
            <%= avatar_tag(notification.actor, size: 10) %>
          <% else %>
            <div class="w-10 h-10 shrink-0 rounded-full bg-cobalt-100 flex items-center justify-center">🔔</div>
          <% end %>
          <div class="min-w-0">
            <p class="text-sm"><%= notification.body %></p>
            <p class="text-xs text-ink/40 mt-0.5"><%= short_time_ago(notification.created_at) %> ago</p>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="p-8 text-center text-sm text-ink/60">Nothing yet. Post something vulnerable and metrics-adjacent.</p>
    <% end %>
  </div>
</div>
