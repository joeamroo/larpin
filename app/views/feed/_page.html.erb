<div class="flex flex-col gap-2">
  <% posts.each_with_index do |post, i| %>
    <%= render "posts/post", post: post %>
    <% if i == 1 && promoted %>
      <%= render "posts/post", post: promoted %>
    <% end %>
    <% if i == 3 && page == 1 %>
      <%= render "shared/credit_card" %>
    <% end %>
  <% end %>
  <% if posts.empty? && page == 1 %>
    <div class="card p-8 text-center text-sm text-ink/60">The feed is empty. Somewhere, a thought leader weeps.</div>
  <% end %>
</div>

<% if has_next %>
  <%= turbo_frame_tag "feed_page_#{page + 1}", src: root_path(page: page + 1, sort: sort), loading: :lazy do %>
    <div class="card mt-2 px-4 py-4">
      <div class="flex items-start gap-2.5">
        <div class="skeleton w-12 h-12 !rounded-full shrink-0"></div>
        <div class="flex-1 pt-1">
          <div class="skeleton h-3 w-40 mb-2"></div>
          <div class="skeleton h-2.5 w-56"></div>
        </div>
      </div>
      <div class="mt-4 space-y-2">
        <div class="skeleton h-3 w-full"></div>
        <div class="skeleton h-3 w-11/12"></div>
        <div class="skeleton h-3 w-3/5"></div>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="py-8 text-center text-xs text-ink/40">
    You've reached the end of the feed. NPCs stop here. Larpmaxxers scroll back up and post.
  </div>
<% end %>
