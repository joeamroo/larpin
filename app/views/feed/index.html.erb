<div class="max-w-[1128px] mx-auto grid grid-cols-1 lg:grid-cols-[225px_minmax(0,1fr)_300px] gap-6 items-start">
  <aside class="hidden lg:block sticky top-[68px]">
    <%= render "shared/profile_card", persona: current_persona if current_persona %>
  </aside>

  <section class="min-w-0">
    <%= render "posts/composer" %>

    <div class="flex items-center gap-2 mt-2 mb-2">
      <div class="flex-1 border-t border-black/15"></div>
      <span class="text-xs text-ink/60">Sort by:</span>
      <% { "hot" => "Hot", "new" => "Recent", "top" => "Top" }.each do |key, label| %>
        <%= link_to label, root_path(sort: key),
              class: "text-xs #{@sort == key ? 'font-bold text-ink' : 'font-medium text-ink/60 hover:text-ink'}" %>
      <% end %>
    </div>

    <turbo-frame id="feed_page_1">
      <%= render "feed/page", posts: @posts, promoted: @promoted, page: 1, sort: @sort, has_next: @has_next %>
    </turbo-frame>
  </section>

  <aside class="hidden lg:flex flex-col gap-2 sticky top-[68px]">
    <%= render "shared/right_rail" %>
  </aside>
</div>
