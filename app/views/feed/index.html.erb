<div class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)_280px] gap-5 items-start">
  <aside class="hidden lg:block sticky top-[72px]">
    <%= render "shared/profile_card", persona: current_persona if current_persona %>
  </aside>

  <section>
    <%= render "posts/composer" %>

    <div class="flex items-center gap-1 mt-4 mb-2 px-1">
      <span class="text-xs text-ink/50 mr-2">Sort feed:</span>
      <% { "hot" => "🔥 Hot", "new" => "🕐 New", "top" => "🏆 Top" }.each do |key, label| %>
        <%= link_to label, root_path(sort: key),
              class: "text-xs font-semibold px-3 py-1 rounded-full #{@sort == key ? 'bg-cobalt-700 text-white' : 'bg-white border border-black/10 text-ink/70 hover:bg-cobalt-50'}" %>
      <% end %>
    </div>

    <turbo-frame id="feed_page_1">
      <%= render "feed/page", posts: @posts, promoted: @promoted, page: 1, sort: @sort, has_next: @has_next %>
    </turbo-frame>
  </section>

  <aside class="hidden lg:flex flex-col gap-4 sticky top-[72px]">
    <%= render "shared/right_rail" %>
  </aside>
</div>
