<% content_for :title, "The Larpboard - LarpIn" %>
<div class="max-w-xl mx-auto flex flex-col gap-2">
  <div class="card p-5">
    <h1 class="display text-2xl">🏆 The Larpboard</h1>
    <p class="text-xs text-ink/60 mt-1">
      <% if @board == "aura" %>
        Ranked by aura, the social capital you farm by posting, reacting, and mogging.
        None of it is real. Everyone competes anyway. That's the sport.
      <% else %>
        Ranked by followers, the only status signal that matters here.
        Most of these numbers are invented. Climbing a fake leaderboard is still climbing.
      <% end %>
    </p>
    <div class="flex gap-1.5 mt-3">
      <%= link_to "Followers", larpboard_path(board: "followers"), class: "text-xs font-semibold px-3 py-1.5 rounded-full #{@board == 'followers' ? 'bg-cobalt-600 text-white' : 'bg-black/5 text-ink/70 hover:bg-black/10'}" %>
      <%= link_to "✨ Aura", larpboard_path(board: "aura"), class: "text-xs font-semibold px-3 py-1.5 rounded-full #{@board == 'aura' ? 'bg-accent-600 text-white' : 'bg-black/5 text-ink/70 hover:bg-black/10'}" %>
    </div>
    <% if @my_rank %>
      <p class="mt-3 text-sm font-semibold text-cobalt-600">You are #<%= @my_rank %> on the <%= @board %> board. <%= @my_rank <= 3 ? "Touch grass immediately." : "Post more. Mog someone. Climb." %></p>
    <% elsif @persona %>
      <p class="mt-3 text-sm text-ink/60">You are unranked. The grind chooses who it perceives. <%= link_to "Start posting", root_path, class: "font-semibold text-cobalt-600 hover:underline" %>.</p>
    <% end %>
  </div>

  <div class="card divide-y divide-black/5">
    <% @ranked.each_with_index do |persona, i| %>
      <% rank = i + 1 %>
      <div class="flex items-center gap-3 px-4 py-3 <%= 'bg-cobalt-50/60' if @persona&.id == persona.id %>">
        <span class="w-9 shrink-0 text-center font-bold num <%= rank <= 3 ? 'text-xl' : 'text-sm text-ink/50' %>">
          <%= rank == 1 ? "🥇" : rank == 2 ? "🥈" : rank == 3 ? "🥉" : "##{rank}" %>
        </span>
        <%= link_to persona_path(persona), class: "shrink-0" do %><%= avatar_tag(persona, size: 10) %><% end %>
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-1.5">
            <%= link_to persona.name, persona_path(persona), class: "font-semibold text-sm hover:underline truncate" %>
            <%= verified_check(persona) %>
            <%= premium_badge(persona) %>
            <% if @persona&.id == persona.id %><span class="text-[11px] font-bold text-cobalt-600 shrink-0">YOU</span><% end %>
          </div>
          <p class="text-xs text-ink/55 truncate"><%= persona.headline %></p>
        </div>
        <div class="text-right shrink-0">
          <% if @board == "aura" %>
            <p class="font-bold text-sm text-accent-600 num">✨ <%= number_with_delimiter(persona.aura) %></p>
            <p class="text-[11px] text-ink/50">aura</p>
          <% else %>
            <p class="font-bold text-sm text-cobalt-600 num"><%= number_with_delimiter(persona.connection_count) %></p>
            <p class="text-[11px] text-ink/50">followers</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <p class="text-xs text-ink/45 text-center px-4 pb-2">
    <%= @board == "aura" ? "Aura is farmed, mogged, and occasionally lost. It is not redeemable for anything." : "Follower counts include implied followers, imagined followers, and followers in Stealth Mode." %>
  </p>
</div>
