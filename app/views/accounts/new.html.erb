<% content_for :title, "Claim your persona - LarpIn" %>
<div class="max-w-md mx-auto px-3 sm:px-0">
  <div class="card p-5 sm:p-6">
    <h1 class="display text-xl sm:text-2xl leading-snug mb-1">Claim your persona</h1>
    <p class="text-sm text-ink/60 mb-5">Pick your name, add an email and password, and your larp survives cleared cookies and new devices. No verification email. We trust you, which is our first mistake.</p>

    <%= form_with url: signup_path, method: :post do |f| %>
      <div class="flex flex-col gap-4">
        <div>
          <label class="block text-xs font-bold mb-1">Your name (any name, obviously)</label>
          <%= f.text_field "persona[name]", value: @persona.name, maxlength: 60, required: true,
                class: "w-full rounded-lg border border-black/25 px-3 py-2.5 text-sm focus:outline-none focus:border-cobalt-600 focus:ring-1 focus:ring-cobalt-600" %>
        </div>
        <div>
          <label class="block text-xs font-bold mb-1">Email</label>
          <%= f.email_field "persona[email]", placeholder: "ceo@stealth.startup", required: true,
                class: "w-full rounded-lg border border-black/25 px-3 py-2.5 text-sm focus:outline-none focus:border-cobalt-600 focus:ring-1 focus:ring-cobalt-600" %>
        </div>
        <div>
          <label class="block text-xs font-bold mb-1">Password (6+ characters)</label>
          <%= f.password_field "persona[password]", minlength: 6, required: true, autocomplete: "new-password",
                class: "w-full rounded-lg border border-black/25 px-3 py-2.5 text-sm focus:outline-none focus:border-cobalt-600 focus:ring-1 focus:ring-cobalt-600" %>
        </div>
        <%= f.submit "Claim it", class: "w-full bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-bold rounded-full py-2.5 cursor-pointer" %>
      </div>
    <% end %>

    <p class="text-xs text-ink/50 mt-4 text-center">
      Already claimed on another device? <%= link_to "Sign in", login_path, class: "font-semibold text-cobalt-600 hover:underline" %>
      · or <%= link_to "keep larping anonymously", root_path, class: "font-semibold text-cobalt-600 hover:underline" %>
    </p>
  </div>
</div>
