<% content_for :title, "LarpIn Premium - $0/month, billed never" %>
<div class="max-w-3xl mx-auto flex flex-col gap-4 px-3 sm:px-0">
  <div class="text-center pt-4">
    <span class="inline-flex items-center gap-1.5 text-2xl font-bold">
      Larp<span class="w-8 h-8 rounded-[4px] bg-gold-500 text-white text-[19px] font-bold leading-none inline-flex items-center justify-center pt-px">in</span>
      <span class="text-gold-500">Premium</span>
    </span>
    <p class="text-sm text-ink/60 mt-2 max-w-md mx-auto">Achieve your goals faster, or at least look like you are, which on this platform is the same thing.</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="card p-5">
      <h2 class="font-bold text-base">Free</h2>
      <p class="text-2xl font-bold mt-1">$0<span class="text-xs font-medium text-ink/50">/mo</span></p>
      <ul class="text-xs text-ink/70 mt-3 space-y-2">
        <li>✓ Unlimited larping</li>
        <li>✓ Fake analytics</li>
        <li>✓ Instant job rejections</li>
        <li class="text-ink/40">✗ Gold badge</li>
        <li class="text-ink/40">✗ Search</li>
      </ul>
      <p class="mt-4 text-xs font-semibold text-ink/50 text-center border border-black/10 rounded-full py-1.5">Your current plan</p>
    </div>

    <div class="card p-5 !ring-2 !ring-gold-500 relative">
      <span class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-gold-500 text-white text-[11px] font-bold rounded-full px-3 py-0.5">MOST POPULAR</span>
      <h2 class="font-bold text-base text-gold-500">Premium</h2>
      <p class="text-2xl font-bold mt-1">$0<span class="text-xs font-medium text-ink/50">/mo, billed never</span></p>
      <ul class="text-xs text-ink/70 mt-3 space-y-2">
        <li>✓ Everything in Free</li>
        <li>✓ <span class="font-semibold">Gold badge</span> (does nothing)</li>
        <li>✓ <span class="font-semibold">Search unlocked</span> (it was always free to build. We just gated it.)</li>
        <li>✓ Feeling of progress</li>
      </ul>
      <% if current_persona&.premium? %>
        <p class="mt-4 text-xs font-semibold text-gold-500 text-center border border-gold-500 rounded-full py-1.5">✓ Active forever</p>
      <% else %>
        <%= button_to "Start free trial of nothing", premium_activate_path, form_class: "btn-form", class: "mt-4 w-full text-sm font-bold text-white bg-gold-500 hover:opacity-90 rounded-full py-2 cursor-pointer" %>
      <% end %>
    </div>

    <div class="card p-5">
      <h2 class="font-bold text-base">Premium+</h2>
      <p class="text-2xl font-bold mt-1">$0<span class="text-xs font-medium text-ink/50">/mo + your dignity</span></p>
      <ul class="text-xs text-ink/70 mt-3 space-y-2">
        <li>✓ Everything in Premium</li>
        <li>✓ We call you at 4 AM to ask if you're grinding</li>
        <li>✓ Your rejections arrive before you apply</li>
        <li>✓ Direct line to HR (does not exist)</li>
      </ul>
      <button class="mt-4 w-full text-sm font-semibold text-ink/40 border border-black/10 rounded-full py-2 cursor-not-allowed" title="Sales will reach out. Sales is also a concept.">Contact sales</button>
    </div>
  </div>

  <p class="text-center text-xs text-ink/40 pb-4">Cancel anytime. There is nothing to cancel.</p>
</div>
