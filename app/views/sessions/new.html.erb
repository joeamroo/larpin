<% content_for :title, "Sign in - LarpIn" %>
<div class="max-w-md mx-auto px-3 sm:px-0">
  <div class="card p-5 sm:p-6">
    <h1 class="display text-xl sm:text-2xl leading-snug mb-1">Sign in</h1>
    <p class="text-sm text-ink/60 mb-5">Resume the bit exactly where you left it.</p>

    <%= form_with url: login_path, method: :post do |f| %>
      <div class="flex flex-col gap-4">
        <div>
          <label class="block text-xs font-bold mb-1">Email</label>
          <%= f.email_field :email, required: true, autofocus: true,
                class: "w-full rounded-lg border border-black/25 px-3 py-2.5 text-sm focus:outline-none focus:border-cobalt-600 focus:ring-1 focus:ring-cobalt-600" %>
        </div>
        <div>
          <label class="block text-xs font-bold mb-1">Password</label>
          <%= f.password_field :password, required: true, autocomplete: "current-password",
                class: "w-full rounded-lg border border-black/25 px-3 py-2.5 text-sm focus:outline-none focus:border-cobalt-600 focus:ring-1 focus:ring-cobalt-600" %>
        </div>
        <%= f.submit "Sign in", class: "w-full bg-cobalt-600 hover:bg-cobalt-700 text-white text-sm font-bold rounded-full py-2.5 cursor-pointer" %>
      </div>
    <% end %>

    <p class="text-xs text-ink/50 mt-4 text-center">
      No account? <%= link_to "Claim your persona", signup_path, class: "font-semibold text-cobalt-600 hover:underline" %>.
      Forgot your password? So did we. There is no reset. Start a new life.
    </p>
  </div>
</div>
